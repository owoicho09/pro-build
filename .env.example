# --- Slice 1: required now ---------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (Settings -> Database -> Connection string,
# "URI" / session pooler). Used by drizzle-kit and background jobs only.
DATABASE_URL=

# --- Slice 2+: required once the builder loop is wired up ---------------

# v0 Platform API key (v0.app/settings/keys)
V0_API_KEY=

# Vercel (Account/Team Settings -> Tokens; team id from Team Settings -> General).
# Needed for Slice 6 (publish): Vercel projects v0 creates have deployment
# protection on by default, which this token is used to turn off after
# publish so the site is actually publicly reachable — use a token from the
# SAME Vercel account as V0_API_KEY's login, since that's the account/team
# that actually owns v0-created Vercel projects. Also needed for Slice 10
# (custom domains): connecting/verifying a domain on a project's Vercel
# project uses this same token.
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=

# Random string (16+ chars) — Vercel Cron sends it back as
# `Authorization: Bearer <value>` on every invocation of /api/cron/advance-builds.
# e.g.: openssl rand -hex 16
CRON_SECRET=

# --- Slice 7: customer project secrets -----------------------------------

# 32-byte key (base64) used to encrypt customer-supplied integration secrets
# at rest, e.g.: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Slice 8: rate limiting -----------------------------------------------

# NOT currently used — Slice 8 ended up implementing rate limiting as a
# plain DB query (count of recent builds) instead of Upstash, a simpler
# alternative for V1 scale (see README "Known limitations"). Left here as
# the placeholder for if/when that needs to move to Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Slice 9: billing -------------------------------------------------------

# From your Paystack dashboard (Settings -> API Keys & Webhooks). No
# separate webhook secret exists — Paystack signs webhook payloads with
# this same secret key (HMAC-SHA512, verified in paystack-billing.ts).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Slice 11: notifications & admin --------------------------------------

# Optional — email delivery is best-effort. Without it, in-app notifications
# (the guaranteed delivery path) still work; this just adds email on top.
RESEND_API_KEY=
# Optional — defaults to Resend's own test sender if unset. Needs a
# domain verified in your Resend account to send to real recipients.
RESEND_FROM_EMAIL=

# Comma-separated list of emails allowed to view /admin. Checked
# server-side only — never sent to the client. Anyone else hitting /admin
# gets a plain 404, same as a route that doesn't exist.
ADMIN_EMAILS=
